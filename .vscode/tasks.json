{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "CMake: configure",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-G", "Ninja",
        "-DCMAKE_BUILD_TYPE=Debug",
        "-DCMAKE_CXX_COMPILER=C:/mingw64/bin/g++.exe",
        "-S", "${workspaceFolder}",
        "-B", "${workspaceFolder}/build"
      ],
      "problemMatcher": [],
      "detail": "Generate the CMake build system into build/ (run once, or after adding files)."
    },
    {
      "label": "CMake: build current file",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build", "${workspaceFolder}/build",
        "--target", "${fileBasenameNoExtension}"
      ],
      "dependsOn": ["CMake: configure"],
      "dependsOrder": "sequence",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": ["$gcc"],
      "detail": "Configure (if needed) and compile only the currently open .cpp file."
    },
    {
      "label": "CMake: run current file",
      "type": "process",
      "command": "${fileDirname}/${fileBasenameNoExtension}.exe",
      "dependsOn": ["CMake: build current file"],
      "dependsOrder": "sequence",
      "options": {
        "cwd": "${fileDirname}"
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      },
      "problemMatcher": [],
      "detail": "Build and run the currently open .cpp file (type stdin in the terminal)."
    }
  ]
}
